  "cards": [
    {
      "dot": "violet",
      "title": "Identity",
      "items": [
        "The inspector is the Apple ID that claimed the access code",
        "That Apple ID has one email-and-password session",
        "Another Apple ID cannot take over a claimed code"
      ]
    },
    {
      "dot": "rose",
      "title": "Access gate",
      "items": [
        "resolveAccess runs in the app; there is no license server",
        "A cached claim can open the app until CloudKit is reachable again",
        "Missing, retired, or another Apple ID stays on the code screen"
      ]
    },
    {
      "dot": "emerald",
      "title": "Inspection data",
      "items": [
        "Customers, inspections, and items save in the local Core Data store",
        "NSPersistentCloudKitContainer mirrors that store to iCloud.SysInspectDB",
        "The web app reads CD_Customer, CD_Inspection, and CD_InspectionItem in the Core Data zone"
      ]
    },
    {
      "dot": "amber",
      "title": "Side channels",
      "items": [
        "Firebase Analytics and Crashlytics receive events from the iOS app",
        "The web app reads private records and does not issue access codes",
        "Reports are rendered in the iOS Reports tab and in the browser preview"
      ]
    }
  ]
