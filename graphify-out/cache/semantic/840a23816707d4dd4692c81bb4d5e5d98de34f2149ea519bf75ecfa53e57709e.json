{"nodes": [{"id": "adr_0004_session_lastuser_document", "label": "ADR-0004 Session and LastUser", "file_type": "document", "source_file": "docs/adr/0004-session-lastuser.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "adr_0004_session_lastuser_decision", "label": "Session id vs LastUser id on UserManager", "file_type": "concept", "source_file": "docs/adr/0004-session-lastuser.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keeping email and isLoggedIn as Session, or leaving Face ID on session email, tangles 'am I logged in?' with 'who was here last' and prevents logout from clearing Session honestly. Logged in means a Session id is present. Logout keeps LastUser; login and account create replace it; wipe clears both through UserManager."}, {"id": "adr_0004_session_lastuser_session", "label": "Session", "file_type": "concept", "source_file": "docs/adr/0004-session-lastuser.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The logged-in user's id. Callers may read it; only UserManager writes it. Do not store session email or an isLoggedIn bool."}, {"id": "adr_0004_session_lastuser_lastuser", "label": "LastUser", "file_type": "concept", "source_file": "docs/adr/0004-session-lastuser.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "User id of the last account that held a Session, used for Face ID after logout. Do not treat LastUser as logged in."}, {"id": "adr_0004_session_lastuser_usermanager", "label": "UserManager", "file_type": "concept", "source_file": "docs/adr/0004-session-lastuser.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Owns Session and LastUser. Wipe calls UserManager, not a blanket key delete. Screens do not read UserDefaults Session or LastUser keys."}, {"id": "adr_0004_session_lastuser_face_id", "label": "Face ID", "file_type": "concept", "source_file": "docs/adr/0004-session-lastuser.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "adr_0004_session_lastuser_userdefaults", "label": "UserDefaults", "file_type": "concept", "source_file": "docs/adr/0004-session-lastuser.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tests inject UserDefaults rather than writing sessionUserId. Screens do not read Session or LastUser keys."}, {"id": "adr_0004_session_lastuser_intake", "label": "Intake", "file_type": "concept", "source_file": "docs/adr/0004-session-lastuser.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rejected option: Session id passed into Intake instead of read from UserManager."}], "edges": [{"source": "adr_0004_session_lastuser_document", "target": "adr_0004_session_lastuser_decision", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0004-session-lastuser.md", "source_location": null, "weight": 1.0}, {"source": "adr_0004_session_lastuser_usermanager", "target": "adr_0004_session_lastuser_session", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0004-session-lastuser.md", "source_location": null, "weight": 1.0}, {"source": "adr_0004_session_lastuser_usermanager", "target": "adr_0004_session_lastuser_lastuser", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0004-session-lastuser.md", "source_location": null, "weight": 1.0}, {"source": "adr_0004_session_lastuser_lastuser", "target": "adr_0004_session_lastuser_face_id", "relation": "conceptually_related_to", "confidence": 