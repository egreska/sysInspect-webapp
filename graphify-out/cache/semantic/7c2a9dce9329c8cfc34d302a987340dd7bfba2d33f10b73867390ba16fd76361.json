{"nodes": [{"id": "adr_0007_report_from_inspections_document", "label": "ADR-0007 ReportFromInspections", "file_type": "document", "source_file": "docs/adr/0007-report-from-inspections.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "adr_0007_report_from_inspections_decision", "label": "Selected Inspections reach Report through ReportFromInspections", "file_type": "concept", "source_file": "docs/adr/0007-report-from-inspections.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "export([Inspection]) on ReportGenerator reopens ADR-0003. Growing the mapper into the orchestrator makes mapping own hop and selection. ReportFromInspections applies empty-selection, hops to a background context, maps snapshots, and calls snapshot export. Do not hop or map on ReportViewController."}, {"id": "adr_0007_report_from_inspections_reportfrominspections", "label": "ReportFromInspections", "file_type": "concept", "source_file": "docs/adr/0007-report-from-inspections.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Empty-selection: PDF first row, CSV all. Hop is not injected. Snapshot export tests stay at Report."}, {"id": "adr_0007_report_from_inspections_reportviewcontroller", "label": "ReportViewController", "file_type": "concept", "source_file": "docs/adr/0007-report-from-inspections.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keeps pick, one canJoin to skip the PDF sheet, share, and two empty-list alert strings. Header, sort, date-range, and layout stay gathered on the screen."}, {"id": "adr_0007_report_from_inspections_reportgenerator", "label": "ReportGenerator", "file_type": "concept", "source_file": "docs/adr/0007-report-from-inspections.md", "source_location": null, "source_url": null, "capt