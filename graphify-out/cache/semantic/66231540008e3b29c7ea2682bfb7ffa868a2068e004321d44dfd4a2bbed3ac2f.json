{"nodes": [{"id": "adr_0010_customer_siteracking_sitedocuments_document", "label": "ADR-0010 Customer SiteRacking and SiteDocuments", "file_type": "document", "source_file": "docs/adr/0010-customer-siteracking-sitedocuments.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "adr_0010_customer_siteracking_sitedocuments_decision", "label": "SiteRacking JSON and SiteDocuments on Customer", "file_type": "concept", "source_file": "docs/adr/0010-customer-siteracking-sitedocuments.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Optional warehouse profile is not an Inspection snapshot, not Issue damage, and not InspectionItem pre-fill. Five binary slots bloat the Customer CloudKit record when one PDF changes; spec rows are never queried across customers. JSON for the small profile and separate records for files match photos: bytes in, bytes out, no slot keys. Empty profile is nil JSON, not {}. Do not add SiteRacking fields to ReportSnapshot or the web customer codec this pass. Do not reuse Issue upright/beam/deck flags for catalog specs."}, {"id": "adr_0010_customer_siteracking_sitedocuments_customer", "label": "Customer", "file_type": "concept", "source_file": "docs/adr/0010-customer-siteracking-sitedocuments.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One Customer is one site. Owns SiteRacking JSON and SiteDocument records."}, {"id": "adr_0010_customer_siteracking_sitedocuments_siteracking", "label": "SiteRacking", "file_type": "concept", "source_file": "docs/adr/0010-customer-siteracking-sitedocuments.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Installed uprights/beams/decks plus blueprints encoded as one optional JSON blob on Customer."}, {"id": "adr_0010_customer_siteracking_sitedocuments_sitedocument", "label": "SiteDocument", "file_type": "concept", "source_file": "docs/adr/0010-customer-siteracking-sitedocuments.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "To-many entity with bytes and filename, cap five. Callers use documentFiles() / replaceDocuments. Keep-by-id must not rewrite data on a name-only save."}, {"id": "adr_0010_customer_siteracking_sitedocuments_catalogname", "label": "CatalogName", "file_type": "concept", "source_file": "docs/adr/0010-customer-siteracking-sitedocuments.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Manufacturer and DeckType names scoped to the Session user. Catalogs are this inspector's list, not a public CloudKit catalog. Rejected: JSON catalogs on User."}, {"id": "adr_0010_customer_siteracking_sitedocuments_customerformstate", "label": "CustomerFormState", "file_type": "concept", "source_file": "docs/adr/0010-customer-siteracking-sitedocuments.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "adr_0010_customer_siteracking_sitedocuments_customerintake", "label": "CustomerIntake", "file_type": "concept", "source_file": "docs/adr/0010-customer-siteracking-sitedocuments.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "adr_0010_customer_siteracking_sitedocuments_hybrid_persist", "label": "Hybrid JSON plus SiteDocument persist", "file_type": "rationale", "source_file": "docs/adr/0010-customer-siteracking-sitedocuments.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "JSON for the small warehouse profile; separate to-many records for files; CatalogName rows for manufacturer/deck type. Avoids slot bloat and an unqueried spec-row graph."}], "edges": [{"source":