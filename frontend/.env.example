# CloudKit JS (browser) - required for Sign in with Apple and data access
# Must match iOS app: Systems Inspector.entitlements → com.apple.developer.icloud-container-identifiers
# Create API token in CloudKit Dashboard → API Access → API Tokens
VITE_CLOUDKIT_CONTAINER_ID=iCloud.SysInspectDB
VITE_CLOUDKIT_API_TOKEN=your-cloudkit-api-token
# Must match where your data lives: development (Xcode debug) or production (TestFlight/App Store)
VITE_CLOUDKIT_ENVIRONMENT=development
