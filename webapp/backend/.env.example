# Server Configuration
# For production (Coolify): set these in Coolify UI, not in a file.
NODE_ENV=production
PORT=3002

# Frontend URL (for CORS)
FRONTEND_URL=https://sysinspect.skynet97.org

# JWT Secret (CHANGE THIS IN PRODUCTION!)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# CloudKit Configuration
CLOUDKIT_CONTAINER_ID=iCloud.com.yourapp.SystemsInspector
CLOUDKIT_ENVIRONMENT=development
CLOUDKIT_API_TOKEN=your-cloudkit-api-token
CLOUDKIT_SERVER_KEY_ID=your-server-to-server-key-id
CLOUDKIT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour private key here\n-----END PRIVATE KEY-----"

# Optional: Company name for reports
INSPECTOR_COMPANY=Systems Inspector
